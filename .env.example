# ============================================================
# Ceazers 3D - Environment Variables (TEMPLATE - SAFE TO COMMIT)
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Then fill in the real values in .env.local.
#
# For production, add these in the Vercel dashboard under:
#   Project -> Settings -> Environment Variables
#
# NEVER put real keys in this file. NEVER commit .env or .env.local.
# ============================================================

# Your Google AI Studio (Gemini) API key.
# Get one free at: https://aistudio.google.com/app/apikey
# The key starts with "AIzaSy..."
GEMINI_API_KEY=your_gemini_api_key_here
